{
  // scripts/build-image.sh がこのディレクトリと features/ を .devcontainer/ に並べてビルドする
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "./features/agent-cli": {},
    "./features/agent-ssh": {},
    "./features/agent-sandbox": {
      "extraDomains": "pypi.org,pythonhosted.org"
    }
  },
  "remoteUser": "vscode"
}
